# ==============================================================================
# A2X Platform Environment Configuration
# ==============================================================================

# Application
APP_ENV=development
APP_NAME=A2X
PORT=8000
DEBUG=True
CORS_ORIGINS=["http://localhost:5173"]

# Security & Auth
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Database
DATABASE_URL=sqlite:///./a2x.db

# LLM (Anthropic Claude API)
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5-5
ANTHROPIC_FALLBACK_MODEL=claude-haiku-5-5

# Vector DB & Embeddings
CHROMA_PERSIST_DIR=./chroma_data

# 포탈 화면 주소(Google 로그인 후 돌아갈 곳)
FRONTEND_URL=http://localhost:5173/
# 개발용 권한 스위치(비우면 APP_ENV=development일 때만 켜짐). 운영에서는 반드시 false
# DEV_ROLE_SWITCH=

# Embeddings · RAG
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_WARMUP=true
UPLOAD_DIR=./uploads

# A2X MCP 런타임(권한 Gateway + MCP/API 중계, 포트 8100)
CONVERTER_PUBLIC_URL=http://localhost:8100
CONVERTER_ENFORCE_PERMISSIONS=true
AGENT_VIA_A2X=true
# 원본 API 토큰: A2X_UPSTREAM_TOKEN_<시스템코드>=...  (예: A2X_UPSTREAM_TOKEN_ERP=)

# 외부 시스템 MCP(1차는 모의 서버 8200)
MASTER_MCP_URL=http://localhost:8200/mcp
IRP_MCP_URL=http://localhost:8200/irp/mcp
DCM_MCP_URL=http://localhost:8200/dcm/mcp
